# 依赖（开发用，最终产物由 GitHub Actions 产出；但保留在本目录便于本地开发）
node_modules/

# 构建产物
dist/
dist-electron/
release/
out/

# pnpm 本地内容寻址缓存（体积大，不入库）
.pnpm-store/

# 日志与缓存
*.log
.vite/
.eslintcache

# 环境变量
.env
.env.*
!.env.example

# 编辑器/系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 本地数据（用户自选根目录下的项目，不入库）
data/
*.local.json
