{
  "name": "ppims",
  "version": "1.0.0",
  "description": "个人项目信息管理系统 · 本地项目资料归档管理工具（v1.0.0 个人归档版）",
  "author": "spicycorn",
  "private": true,
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron .",
    "icons": "node dev/scripts/gen-icon.mjs && node dev/scripts/derive-icons.mjs",
    "build:renderer": "vite build",
    "build:electron": "node dev/scripts/build-electron.mjs",
    "build": "vue-tsc --noEmit && vite build && node dev/scripts/build-electron.mjs",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "electron:build": "electron-builder",
    "electron:build:win": "node dev/scripts/gen-icon.mjs && node dev/scripts/derive-icons.mjs && electron-builder --win",
    "pack:win": "node dev/scripts/gen-icon.mjs && node dev/scripts/derive-icons.mjs && vue-tsc --noEmit && vite build && node dev/scripts/build-electron.mjs && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.7.5",
    "@vitejs/plugin-vue": "^5.1.3",
    "archiver": "^7.0.1",
    "electron": "^31.6.1",
    "electron-builder": "^25.1.8",
    "element-plus": "^2.8.4",
    "esbuild": "^0.23.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pinia": "^2.2.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.2",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.6",
    "xlsx": "^0.18.5"
  }
}
