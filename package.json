    "archiver": "^7.0.1",
    "electron": "^31.6.1",
    "electron-builder": "^25.1.8",
    "element-plus": "^2.8.4",
    "esbuild": "^0.23.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pinia": "^2.2.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.2",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.6",
    "xlsx": "^0.18.5"
  }
