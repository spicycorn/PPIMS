{
  "name": "ppims",
  "version": "1.2.8",
  "description": "个人项目信息管理系统 · 本地项目资料归档管理工具（v1.2.8：修复「关机重启自动启动后 UI 文字位置对不齐」——主窗口改 show:false + ready-to-show 再显示，渲染层等 document.fonts.ready 再挂载，首帧即按真实字体度量，开机自启时机下不再用回退字体布局导致 el-table 行高/列/文本基线错位；手动启动体验不变。v1.2.7：预置模板一次性种入、悬浮窗实时刷新 + 点击导航、新建项目改按钮+对话框）",
  "author": "spicycorn",
  "private": true,
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron .",
    "icons": "node dev/scripts/gen-icon.mjs && node dev/scripts/derive-icons.mjs",
    "build:renderer": "vite build",
    "build:electron": "node dev/scripts/build-electron.mjs",
    "build": "vue-tsc --noEmit && vite build && node dev/scripts/build-electron.mjs",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "electron:build": "electron-builder",
    "electron:build:win": "node dev/scripts/gen-icon.mjs && node dev/scripts/derive-icons.mjs && electron-builder --win",
    "pack:win": "node dev/scripts/gen-icon.mjs && node dev/scripts/derive-icons.mjs && vue-tsc --noEmit && vite build && node dev/scripts/build-electron.mjs && electron-builder --win"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.7.5",
    "@vitejs/plugin-vue": "^5.1.3",
    "archiver": "^7.0.1",
    "electron": "^31.6.1",
    "electron-builder": "^25.1.8",
    "element-plus": "^2.8.4",
    "esbuild": "^0.23.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pinia": "^2.2.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.6",
    "xlsx": "^0.18.5"
  }
}
