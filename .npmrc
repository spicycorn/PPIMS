# 使用国内镜像加速，保证依赖可拉取
registry=https://registry.npmmirror.com/
# node_modules 采用扁平、真实文件（hoisted）结构，而非指向全局 store 的符号链接，
# 使整个项目目录自包含、可在任意机器整体搬移后继续开发（满足“所有依赖都在本目录”约定）。
node-linker=hoisted
# 安装 Electron / 二进制相关包时不强制走原生编译，加快安装
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# 放行需要运行 postinstall 构建脚本的依赖（pnpm 10+ 默认拦截，白名单放行）
onlyBuiltDependencies[]=electron
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=vue-demi
